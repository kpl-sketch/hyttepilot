# Kopier denne filen til .env.local og fyll inn verdiene.

# Postgres-databasen. På Vercel settes denne automatisk når databasen kobles til.
DATABASE_URL=postgres://bruker:passord@vert/database

# Hemmelig nøkkel for innlogging. Valgfri: uten den avledes nøkkelen av
# DATABASE_URL. Lag en egen med: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Adressen tjenesten ligger på. På Vercel settes den bare for produksjon.
# Forhåndsvisninger finner sin egen adresse selv.
BETTER_AUTH_URL=http://localhost:3000

# E-postadressene til administratorene, skilt med komma.
# De kan alltid logge inn, og de inviterer hytteeiere.
ADMIN_EMAILS=

# Utsending av e-post med Resend. Uten disse skrives e-post til
# .dev-outbox.jsonl i utvikling.
RESEND_API_KEY=
EMAIL_FROM="Hyttepilot <hei@eksempel.no>"

# Adressen svar på e-post skal gå til, siden avsenderen ikke har postkasse.
# Uten denne brukes NEXT_PUBLIC_CONTACT_EMAIL.
EMAIL_REPLY_TO=

# Felles innboks under Administrasjon → Innboks. Adressen er den samme som i
# EMAIL_FROM hvis INBOX_EMAIL ikke er satt. Innboksen trenger en Resend-nøkkel
# med full tilgang. Uten RESEND_INBOX_API_KEY prøves RESEND_API_KEY.
INBOX_EMAIL=
RESEND_INBOX_API_KEY=

# Navnet på tjenesten (arbeidsnavn). Byttes her, og bare her.
NEXT_PUBLIC_APP_NAME=Hyttepilot

# Vises på personvernsiden.
NEXT_PUBLIC_CONTROLLER_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=

# Hemmelighet for den daglige jobben som sender påminnelser om ledige hytter.
# Vercel sender den med når jobben kjøres. Lag en med: openssl rand -base64 32
CRON_SECRET=

# Tekstforslag til beskrivelsen av en hytte, laget av en AI-tjeneste ut fra
# bildene, stedet, sengeplassene og eierens egen tekst. Uten AI_GATEWAY_API_KEY er tekstforslag slått
# av: knappen vises ikke, og ingenting sendes ut. Nøkkelen lages under
# AI Gateway i Vercel. Zero data retention krever Pro-plan eller kjøpte
# AI Gateway-kreditter.
AI_GATEWAY_API_KEY=
# Valgfri. Modellen som skriver forslaget. Standard er en rimelig modell:
# anthropic/claude-haiku-5.5. anthropic/claude-sonnet-5.5 skriver trolig bedre,
# men koster om lag tjue ganger så mye per forslag.
# AI_DESCRIPTION_MODEL=
# Valgfri. Adressen forslaget hentes fra. Standard er Vercel AI Gateway i EU.
# Testene peker den til en etterligning.
# AI_DESCRIPTION_URL=https://eu.ai-gateway.vercel.sh/v1/chat/completions

# Henting av profilbilde fra LinkedIn. Uten begge disse vises ikke knappen
# «Hent bildet fra LinkedIn», og ingenting sendes til LinkedIn. Egen opplasting
# av profilbilde virker uansett. Nøklene står under «Auth» i appen på
# developer.linkedin.com. Appen må ha produktet «Sign In with LinkedIn using
# OpenID Connect», og adressen <BETTER_AUTH_URL>/profil/linkedin må stå under
# «Authorized redirect URLs». Se README.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Valgfri. Adressesøket i hytteskjemaet bruker Kartverkets åpne adresseregister.
# Sett denne bare hvis du vil peke søket et annet sted, for eksempel i en test.
# ADDRESS_SEARCH_URL=https://ws.geonorge.no/adresser/v1/sok
